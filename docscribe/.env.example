# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA — si faltan, la app usa respuestas simuladas (modo demo)
# STT (Whisper)
OPENAI_API_KEY=
# LLM: se usa Gemini si hay key; si no, OpenAI; si no, mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Correo del PDF (opcional). Resend: resend.com/api-keys. Sin dominio verificado solo envía al correo de tu cuenta Resend.
RESEND_API_KEY=
EMAIL_FROM=DocScribe <onboarding@resend.dev>
# Local: 40. En Vercel: 4 (límite de body 4.5 MB)
MAX_AUDIO_MB=40

# Llave de servicio de Supabase (solo servidor): permite crear cuentas desde /admin
SUPABASE_SERVICE_ROLE_KEY=
