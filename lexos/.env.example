# =============================================================================
# LexOS Environment Variables — NEVER commit the real .env file
# =============================================================================

# Server
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://lexos_user:CHANGE_ME@localhost:5432/lexos

# Supabase (get from https://supabase.com/dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-minimum-32-characters

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o

# Pinecone (get from https://app.pinecone.io)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=lexos-docs
PINECONE_ENVIRONMENT=us-east-1-aws

# Encryption (generate with: openssl rand -hex 32)
# WARNING: Rotating this key requires re-encrypting ALL data in the database
AES_MASTER_KEY=REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32

# Object Storage (S3-compatible: AWS S3, MinIO, Cloudflare R2)
STORAGE_ENDPOINT=https://s3.eu-west-1.amazonaws.com
STORAGE_BUCKET=lexos-documents-prod
STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
STORAGE_REGION=eu-west-1

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Docker only
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Frontend (Vite — prefix VITE_)
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
